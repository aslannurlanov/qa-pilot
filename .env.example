# Local SQLite only. Relative paths are resolved from the project root.
DATABASE_URL="file:./data/qa-pilot.db"

# Unset or fake: deterministic offline generation, no API key needed.
AI_PROVIDER=fake
# Set AI_PROVIDER=openai to send the task to OpenAI. Never commit a real key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
